index 0000000000000000000000000000000000000000..79ab3cb226cf493d7a0f3cdd2ecfb55378cbbc5a
--- /dev/null
+++ b/python/sglang/srt/mem_cache/joint_policy/residency_invariants.py
@@ -0,0 +1,85 @@
+"""Lock-independent FULL residency invariants.
+
+``UnifiedTreeCore.sanity_check`` already validates these structural rules, but
+it is unreachable during the probability-residency experiments: it is gated on
+``SGLANG_ENABLE_TREE_CACHE_SANITY_CHECK`` (CI-only default), restricted to
+hybrid SWA/Mamba models, skipped whenever a streaming session holds KV, and
+only ever called from ``Scheduler.on_idle``.  A dense model driven by streaming
+sessions under load therefore never runs it, so a broken residency chain stays
+invisible until some later request walks the path and trips the assertion in
+``FullComponent.acquire_component_lock``.
+
+The rules below read only ``value``/``host_value`` presence, never lock_ref, so
+unlike the full sanity check they stay valid while streaming sessions hold
+their cross-turn locks -- which is what makes them usable as a per-mutation
+probe inside the pressure window.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterable, Optional
+
+
+@dataclass(frozen=True)
+class NodeResidency:
+    """Residency state of one non-root tree node.
+
+    ``parent_id`` is None when the parent is the tree root, which always holds
+    a device value and is therefore never a contiguity violation.
+    """
+
+    node_id: int
+    parent_id: Optional[int]
+    has_device: bool
+    has_host: bool
+
+
+def find_residency_contiguity_violations(
+    nodes: Iterable[NodeResidency],
+    *,
+    is_write_back: bool,
+) -> list[str]:
+    """Return one message per violated FULL residency rule (empty == healthy).
+
+    Three rules, mirroring ``sanity_check`` PART 2:
+
+    1. Device residency is contiguous from the root down.  A node holding a
+       device value under an evicted parent is the "hole" that later crashes
+       ``acquire_component_lock``; FULL device eviction is only legal from
+       leaves, and ``build_hicache_transfers`` relies on that to stop its
+       upward walk at the first resident ancestor.
+    2. Outside write-back mode, host backup is contiguous the same way.
+    3. Every node keeps FULL data on at least one layer; a node with neither
+       is unreachable and can never be loaded back.
+    """
+    by_id = {node.node_id: node for node in nodes}
+    violations: list[str] = []
+
+    for node in by_id.values():
+        if not node.has_device and not node.has_host:
+            violations.append(
+                f"node {node.node_id} dead: no FULL device and no FULL host"
+            )
+
+        if node.parent_id is None:
+            continue
+        parent = by_id.get(node.parent_id)
+        if parent is None:
+            violations.append(
+                f"node {node.node_id} parent {node.parent_id} missing from tree"
+            )
+            continue
+
+        if node.has_device and not parent.has_device:
+            violations.append(
+                f"node {node.node_id} device present but parent "
+                f"{node.parent_id} evicted"
+            )
+        if node.has_host and not parent.has_host and not is_write_back:
+            violations.append(
+                f"node {node.node_id} backed up but parent "
+                f"{node.parent_id} not backed up"
+            )
+
+    return violations
diff --git a/python/sglang/srt/mem_cache/joint_policy/two_phase.py b/python/sglang/srt/mem_cache/joint_policy/two_phase.py
new file mode 100644
index 0000000000000000000000000000000000000000..7cf2571916b3653591aa5287cfa0bfd502d5c12a
--- /dev/null
+++ b/python/sglang/srt/mem_cache/joint_policy/two_phase.py
@@ -0,0 +1,286 @@
+"""Experimental v6 controller. Units: allocator tokens; clock: scheduler monotonic.
+
+Feasibility uses a preemptible shared link, per-session rate caps and common
+release time. Host-ready suffixes only. No claim about unknown future requests.
+"""
+from dataclasses import dataclass
+import math
+import os
+import time
+import logging
+
+logger = logging.getLogger(__name__)
+
+@dataclass(frozen=True)
+class Job:
+    sid: str
+    deadline: float
+    total: int
+    resident: int
+    reclaimable: int
+    host_ready: bool = True
+
+    def __post_init__(self):
+        if not math.isfinite(self.deadline) or not 0 <= self.reclaimable <= self.resident <= self.total:
+            raise ValueError('invalid residency snapshot')
+
+
+def feasible(jobs, missing, now, shared_rate, session_rate):
+    """Exact time-expanded max flow for the stated fluid H2D model."""
+    if not all(math.isfinite(v) and v > 0 for v in (shared_rate, session_rate)):
+        raise ValueError("bandwidth must be positive")
+    if any(not j.host_ready and missing[j.sid] > 0 for j in jobs):
+        return False
+    deadlines = sorted({j.deadline for j in jobs if missing[j.sid] > 0})
+    if any(j.deadline <= now and missing[j.sid] > 0 for j in jobs):
+        return False
+    intervals = list(zip([now] + deadlines[:-1], deadlines))
+    n = 2 + len(jobs) + len(intervals)
+    sink = n - 1
+    graph = [dict() for _ in range(n)]
+    def edge(a, b, c):
+        graph[a][b] = c
+        graph[b][a] = 0.0
+    demand = 0
+    for i, j in enumerate(jobs, 1):
+        amount = missing[j.sid]
+        if amount < 0:
+            raise ValueError("negative missing tokens")
+        demand += amount
+        edge(0, i, amount)
+        for k, (a, b) in enumerate(intervals, 1 + len(jobs)):
+            if b <= j.deadline:
+                edge(i, k, session_rate * (b-a))
+    for k, (a, b) in enumerate(intervals, 1 + len(jobs)):
+        edge(k, sink, shared_rate * (b-a))
+    flow = 0.0
+    while flow + 1e-6 < demand:
+        parent = {0: None}
+        queue = [0]
+        for a in queue:
+            for b, capacity in graph[a].items():
+                if capacity > 1e-8 and b not in parent:
+                    parent[b] = a
+                    queue.append(b)
+            if sink in parent:
+                break
+        if sink not in parent:
+            return False
+        delta = float('inf')
+        b = sink
+        while b:
+            a = parent[b]
+            delta = min(delta, graph[a][b])
+            b = a
+        b = sink
+        while b:
+            a = parent[b]
+            graph[a][b] -= delta
+            graph[b][a] += delta
+            b = a
+        flow += delta
