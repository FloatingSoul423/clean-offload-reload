index 0000000000000000000000000000000000000000..6b14f7d3b99ed8c7d53d57365be02c864400eaf7
--- /dev/null
+++ b/python/sglang/srt/observability/transfer_journal.py
@@ -0,0 +1,64 @@
+"""Optional operation lifecycle audit; never authorizes allocation or transfer.
+
+IDs refer to immutable CacheOperations, not mutable radix node ranges. Active
+device tokens are already allocated; they must not be added to pool usage.
+"""
+
+import time
+
+
+class TransferJournal:
+    def __init__(self, emit, clock=time.monotonic):
+        self.emit = emit
+        self.clock = clock
+        self.active = {}
+        self.completed_ops = self.completed_tokens = self.completed_bytes = 0
+
+    def enqueue(self, operation_id, tokens, num_bytes):
+        if (operation_id in self.active or type(tokens) is not int or tokens < 0
+                or type(num_bytes) is not int or num_bytes < 0):
+            raise ValueError("invalid or duplicate transfer operation")
+        self.active[operation_id] = ("queued", tokens, num_bytes)
+        self._emit("queued", [operation_id])
+
+    def _batch(self, operation_ids, expected):
+        ids = list(operation_ids)
+        if (not ids or len(set(ids)) != len(ids)
+                or any(key not in self.active or self.active[key][0] != expected
+                       for key in ids)):
+            raise ValueError("invalid transfer lifecycle transition")
+        return ids
+
+    def submit(self, operation_ids):
+        ids = self._batch(operation_ids, "queued")
+        for key in ids:
+            _, tokens, size = self.active[key]
+            self.active[key] = ("submitted", tokens, size)
+        self._emit("submitted", ids)
+
+    def complete(self, operation_ids):
+        ids = self._batch(operation_ids, "submitted")
+        for key in ids:
+            _, tokens, size = self.active.pop(key)
+            self.completed_ops += 1
+            self.completed_tokens += tokens
+            self.completed_bytes += size
+        self._emit("acknowledged", ids)
+
+    def reset(self):
+        # Reset abandons observation, not proof of DMA cancellation/completion.
+        ids = list(self.active)
+        self._emit("reset_unresolved", ids)
+        self.active.clear()
+
+    def _emit(self, stage, ids):
+        event = dict(stage=stage, operation_ids=ids, monotonic_s=self.clock(),
+                     completed_ops=self.completed_ops,
+                     completed_tokens=self.completed_tokens,
+                     completed_bytes=self.completed_bytes)
+        for state in ("queued", "submitted"):
+            entries = [e for e in self.active.values() if e[0] == state]
+            event[state + "_ops"] = len(entries)
+            event[state + "_tokens"] = sum(e[1] for e in entries)
+            event[state + "_bytes"] = sum(e[2] for e in entries)
+        self.emit(event)
