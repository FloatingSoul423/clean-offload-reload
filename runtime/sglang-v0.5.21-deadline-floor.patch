+
+DeadlineFloorController = floor.DeadlineFloorController
+Job = two_phase.Job
+feasible = two_phase.feasible
+
+
+def make_controller(
+    specs, *, shared=4, per_session=4, safety=1.0, capacity=100, free=0
+):
+    controller = object.__new__(DeadlineFloorController)
+    controller.deadlines = {sid: deadline for sid, deadline, _, _ in specs}
+    controller.last_tick = 0.0
+    controller.interval = 0.1
+    controller.shared = shared
+    controller.per_session = per_session
+    controller.safety = safety
+    controller.reserve_low = 0.10
+    controller.reserve_high = 0.15
+    controller.reserve_step = 0.02
+    controller.reserve_cooldown = 0.5
+    controller.idle_grace = 0.1
+    controller.reserve_active = False
+    controller.idle_since = None
+    controller.last_reserve = float("-inf")
+    controller.busy = False
+    controller.last_decision = {}
+    state = {
+        "resident": {sid: resident for sid, _, _, resident in specs},
+        "total": {sid: total for sid, _, total, _ in specs},
+        "free": free,
+        "calls": [],
+    }
+
+    def set_probability(sid, probability):
+        old = state["resident"][sid]
+        new = round(probability * state["total"][sid])
+        state["resident"][sid] = new
+        state["free"] += old - new
+        state["calls"].append((sid, new))
+        return {"applied": True}
+
+    controller.cache = SimpleNamespace(
+        page_size=1,
+        tree_components=(0,),
+        ongoing_load_back={},
+        deadline_floor_scheduler_idle=False,
+        token_to_kv_pool_allocator=SimpleNamespace(size_full=capacity),
+        _component_available_size=lambda _: state["free"],
+        set_tool_return_probability=set_probability,
+    )
+
+    def snapshot():
+        return [
+            Job(
+                sid,
+                deadline,
+                state["total"][sid],
+                state["resident"][sid],
+                state["resident"][sid],
+            )
+            for sid, deadline, _, _ in specs
+        ]
+
+    controller.snapshot = snapshot
+    return controller, state
+
+
