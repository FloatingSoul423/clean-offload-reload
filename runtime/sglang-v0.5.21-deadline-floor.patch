+import importlib.util
+from pathlib import Path
+import unittest
+from types import SimpleNamespace
+
+
+SOURCE = Path(__file__).resolve().parents[4] / "python/sglang/srt/mem_cache/joint_policy/pressure_telemetry.py"
+SPEC = importlib.util.spec_from_file_location("pressure_telemetry", SOURCE)
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+PressureSampler = MODULE.PressureSampler
+
+
+class FakeCache:
+    def __init__(self, capacity=100, available=20, evictable=30, inflight=2):
+        self.token_to_kv_pool_allocator = SimpleNamespace(size_full=capacity)
+        self.tree_components = ["FULL"]
+        self.available = available
+        self.evictable = evictable
+        self.ongoing_load_back = dict.fromkeys(range(inflight))
+        self.cache_controller = None
+
+    def _component_available_size(self, component):
+        self.assert_component = component
+        return self.available
+
+    def full_evictable_size(self):
+        return self.evictable
+
+
+class PressureSamplerTest(unittest.TestCase):
+    def test_admission_intervals_survive_sampling_gaps(self):
+        sampler = PressureSampler(1, clock=lambda: 1, queue_clock=lambda: 105)
+        sampler.maybe_sample(FakeCache(), 2, [100, 104])
+        event = sampler.admitted_queue_intervals(iter([100, 104]))
+        self.assertEqual(event, dict(queue_clock_s=105, entry_times_s=[100, 104],
+                                    admitted_episodes=2, invalid_entry_times=0))
+        self.assertEqual(sampler.last_sample, 1)
+        self.assertIsNone(sampler.maybe_sample(FakeCache(), 0))
+
+    def test_admission_reports_invalid_or_missing_entries(self):
+        sampler = PressureSampler(1, queue_clock=lambda: 100)
+        event = sampler.admitted_queue_intervals([0, 101, float("nan"), 99])
+        self.assertEqual(event["entry_times_s"], [99])
+        self.assertEqual(event["invalid_entry_times"], 3)
+        self.assertEqual(sampler.admitted_queue_intervals([])["admitted_episodes"], 0)
+
+    def test_accounting_and_elapsed_time(self):
+        times = iter((10.0, 10.2, 10.6, 12.0))
+        sampler = PressureSampler(0.5, clock=lambda: next(times))
+        cache = FakeCache()
+        first = sampler.maybe_sample(cache, 3)
+        self.assertEqual(first["allocated_tokens"], 80)
+        self.assertEqual(first["non_evictable_tokens"], 50)
+        self.assertEqual(first["allocation_usage"], 0.8)
+        self.assertEqual(first["non_evictable_usage"], 0.5)
+        self.assertEqual(first["h2d_inflight_nodes"], 2)
+        self.assertIsNone(sampler.maybe_sample(cache, 3))
+        second = sampler.maybe_sample(cache, 4)
+        self.assertAlmostEqual(second["elapsed_since_sample_s"], 0.6)
+        self.assertEqual(second["waiting_requests"], 4)
+        third = sampler.maybe_sample(cache, 0)
+        self.assertAlmostEqual(third["elapsed_since_sample_s"], 1.4)
+
+    def test_invalid_accounting_does_not_advance_timer(self):
+        times = iter((1.0, 1.1))
+        sampler = PressureSampler(0.5, clock=lambda: next(times))
+        with self.assertRaises(ValueError):
+            sampler.maybe_sample(FakeCache(available=80, evictable=30), 0)
+        self.assertIsNotNone(sampler.maybe_sample(FakeCache(), 0))
+
+    def test_h2d_queue_stages_are_counted_once(self):
+        cache = FakeCache()
+        cache.cache_controller = SimpleNamespace(
+            load_queue=[SimpleNamespace(device_indices=[1, 2, 3])],
+            ack_load_queue=[SimpleNamespace(num_tokens=4, num_bytes=48)],
+            _transfer_num_bytes=lambda op: 12 * len(op.device_indices),
+        )
+        sample = PressureSampler(1, clock=lambda: 1).maybe_sample(cache, 0)
+        self.assertEqual(sample["h2d_queued_tokens"], 3)
+        self.assertEqual(sample["h2d_queued_bytes"], 36)
+        self.assertEqual(sample["h2d_submitted_tokens"], 4)
+        self.assertEqual(sample["h2d_submitted_bytes"], 48)
+        self.assertEqual(sample["h2d_reserved_tokens"], 7)
+        self.assertEqual(sample["allocated_tokens"], 80)
+        self.assertEqual(sample["h2d_inflight_nodes"], 2)
+
+    def test_interval_and_waiting_validation(self):
+        with self.assertRaises(ValueError):
+            PressureSampler(0)
+        with self.assertRaises(ValueError):
+            PressureSampler(61)
+        with self.assertRaises(ValueError):
+            PressureSampler(1, clock=lambda: 1).maybe_sample(FakeCache(), -1)
+
+    def test_backward_clock_is_rejected_before_interval_gate(self):
+        times = iter((10.0, 9.9))
+        sampler = PressureSampler(1, clock=lambda: next(times))
+        sampler.maybe_sample(FakeCache(), 0)
+        with self.assertRaisesRegex(ValueError, "clock moved backward"):
+            sampler.maybe_sample(FakeCache(), 0)
+
+    def test_prefill_defer_attempts_accumulate_until_sample(self):
+        times = iter((1.0, 1.1, 1.5))
+        sampler = PressureSampler(0.5, clock=lambda: next(times))
+        sampler.record_prefill_defer("no_token")
+        first = sampler.maybe_sample(FakeCache(), 1)
+        self.assertEqual(first["prefill_no_token_attempts"], 1)
+        sampler.record_prefill_defer("no_token")
+        sampler.record_prefill_defer("no_token")
+        sampler.record_prefill_defer("prefetch_pending")
+        self.assertIsNone(sampler.maybe_sample(FakeCache(), 1))
+        second = sampler.maybe_sample(FakeCache(), 1)
+        self.assertEqual(second["prefill_no_token_attempts"], 2)
+        self.assertEqual(second["prefill_prefetch_pending_attempts"], 1)
+        with self.assertRaises(ValueError):
+            sampler.record_prefill_defer("unknown")
+
+    def test_waiting_age_uses_queue_clock_and_reports_missing_entries(self):
+        sampler = PressureSampler(1, clock=lambda: 5, queue_clock=lambda: 100)
+        sample = sampler.maybe_sample(FakeCache(), 4, [99.9, 99.8, 99.7, 0])
+        self.assertEqual(sample["waiting_age_observed_requests"], 3)
+        self.assertAlmostEqual(sample["waiting_age_max_s"], .3)
+        self.assertAlmostEqual(sample["waiting_age_p95_s"], .3)
+        empty = PressureSampler(1, clock=lambda: 5).maybe_sample(FakeCache(), 0)
+        self.assertIsNone(empty["waiting_age_max_s"])
+        with self.assertRaises(ValueError):
+            PressureSampler(1, clock=lambda: 5).maybe_sample(FakeCache(), 0, [1])
+
+
+if __name__ == "__main__":
+    unittest.main()
