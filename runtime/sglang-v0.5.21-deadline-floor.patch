@@ -0,0 +1,88 @@
+"""Tests for the H2D producer-slot reserve used by the proactive flush.
+
+``LayerDoneCounter`` has 3 slots and two producers: the proactive policy
+flush, and the prefill path in ``_get_new_batch_prefill_raw``, which calls
+``ready_to_load_host_cache`` unguarded because it already has a batch to
+serve. A background producer that only checks the next slot can therefore
+take the slot the request path is about to need, which asserts inside
+``update_producer`` under the prefill traceback.
+
+The real method is bound to a stub counter so these cases exercise the
+shipped implementation without needing a CUDA device.
+"""
+
+from types import SimpleNamespace
+
+from sglang.srt.managers.cache_controller import HiCacheController
+
+
+def make_controller(ready_flags, producer_index):
+    """Bind the real can_start_loading to a stub with the given slot states."""
+    events = [
+        SimpleNamespace(finish_event=SimpleNamespace(query=lambda r=r: r))
+        for r in ready_flags
+    ]
+    stub = SimpleNamespace(
+        layer_done_counter=SimpleNamespace(
+            events=events, producer_index=producer_index
+        )
+    )
+    return HiCacheController.can_start_loading.__get__(stub)
+
+
+def test_reserve_zero_only_checks_next_slot():
+    # Next slot free, the one after is in flight: legal without a reserve.
+    can = make_controller([True, True, False], producer_index=0)
+    assert can() is True
+    assert can(reserve=0) is True
+
+
+def test_reserve_one_also_requires_the_slot_after_next():
+    # Same state: with a reserve the proactive producer must decline, leaving
+    # the in-flight-adjacent slot for the request path.
+    can = make_controller([True, True, False], producer_index=0)
+    assert can(reserve=1) is False
+
+
+def test_reserve_one_allows_when_two_slots_are_free():
+    can = make_controller([False, True, True], producer_index=0)
+    assert can(reserve=1) is True
+
+
+def test_next_slot_in_flight_blocks_every_reserve():
+    can = make_controller([True, False, True], producer_index=0)
+    assert can() is False
+    assert can(reserve=0) is False
+    assert can(reserve=1) is False
+
+
+def test_index_walk_wraps_around_the_ring():
+    # producer_index=2 -> next is 0, then 1.
+    can = make_controller([True, False, True], producer_index=2)
+    assert can(reserve=0) is True
+    assert can(reserve=1) is False
+
+    can = make_controller([True, True, False], producer_index=2)
+    assert can(reserve=1) is True
+
+
+def test_initial_producer_index_minus_one_starts_at_slot_zero():
+    can = make_controller([False, True, True], producer_index=-1)
+    assert can(reserve=0) is False
+
+    can = make_controller([True, False, True], producer_index=-1)
+    assert can(reserve=0) is True
+    assert can(reserve=1) is False
+
+
+def test_negative_reserve_is_treated_as_zero():
+    can = make_controller([True, True, False], producer_index=0)
+    assert can(reserve=-1) is True
+
+
+def test_full_reserve_requires_the_whole_ring_free():
+    can = make_controller([True, True, True], producer_index=0)
+    assert can(reserve=2) is True
+
+    can = make_controller([False, True, True], producer_index=0)
+    assert can(reserve=2) is False
