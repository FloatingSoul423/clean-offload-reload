+"""Tests for the lock-independent FULL residency contiguity probe."""
+
+import importlib.util
+import sys
+from pathlib import Path
+
+_MODULE_PATH = (
+    Path(__file__).resolve().parents[4]
+    / "python"
+    / "sglang"
+    / "srt"
+    / "mem_cache"
+    / "joint_policy"
+    / "residency_invariants.py"
+)
+_SPEC = importlib.util.spec_from_file_location("residency_invariants", _MODULE_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+_MODULE = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = _MODULE
+_SPEC.loader.exec_module(_MODULE)
+NodeResidency = _MODULE.NodeResidency
+find = _MODULE.find_residency_contiguity_violations
+
+
+def chain(*layers):
+    """Build a root-anchored chain; each layer is (has_device, has_host)."""
+    nodes = []
+    for i, (dev, host) in enumerate(layers):
+        nodes.append(
+            NodeResidency(
+                node_id=i + 1,
+                parent_id=None if i == 0 else i,
+                has_device=dev,
+                has_host=host,
+            )
+        )
+    return nodes
+
+
+def test_fully_resident_chain_is_clean():
+    assert find(chain((True, True), (True, True)), is_write_back=False) == []
+
+
+def test_device_evicted_from_the_bottom_is_clean():
+    # The legal shape: device residency shrinks from the leaf upward, so the
+    # resident segment stays contiguous from the root.
+    nodes = chain((True, True), (True, True), (False, True), (False, True))
+    assert find(nodes, is_write_back=False) == []
+
+
+def test_device_hole_above_resident_descendant_is_reported():
+    # The shape that later trips acquire_component_lock: node 3 holds a device
+    # value while its parent 2 is evicted.
+    nodes = chain((True, True), (False, True), (True, True))
+    violations = find(nodes, is_write_back=False)
+    assert len(violations) == 1
+    assert "node 3 device present but parent 2 evicted" in violations[0]
+
+
+def test_dead_node_with_neither_layer_is_reported():
+    nodes = chain((True, True), (False, False))
+    violations = find(nodes, is_write_back=False)
+    assert any("node 2 dead" in v for v in violations)
+
+
+def test_host_contiguity_enforced_only_outside_write_back():
+    # A host-only hole: node 2 is backed up, its parent is not.
+    nodes = [
+        NodeResidency(node_id=1, parent_id=None, has_device=True, has_host=False),
+        NodeResidency(node_id=2, parent_id=1, has_device=True, has_host=True),
+    ]
+    assert any(
+        "not backed up" in v for v in find(nodes, is_write_back=False)
+    )
+    # write_back reclaims the Full host layer independently, so the same shape
+    # is legal there.
+    assert find(nodes, is_write_back=True) == []
+
+
+def test_root_parented_nodes_are_never_violations():
+    # parent_id None means the parent is the root, which always holds a value.
+    nodes = [NodeResidency(node_id=1, parent_id=None, has_device=True, has_host=False)]
+    assert find(nodes, is_write_back=False) == []
+
+
+def test_missing_parent_is_reported():
+    nodes = [NodeResidency(node_id=5, parent_id=4, has_device=True, has_host=True)]
+    violations = find(nodes, is_write_back=False)
+    assert len(violations) == 1
+    assert "parent 4 missing from tree" in violations[0]
+
+
+def test_multiple_violations_are_all_collected():
+    nodes = chain((True, True), (False, True), (True, True), (False, False))
+    violations = find(nodes, is_write_back=False)
+    assert len(violations) == 2
+    assert any("node 3 device present but parent 2 evicted" in v for v in violations)
+    assert any("node 4 dead" in v for v in violations)
