index 0000000000000000000000000000000000000000..12cfac197240301fcb11c49af94a8a8c9a5b44d6
--- /dev/null
+++ b/test/registered/unit/mem_cache/test_transfer_journal.py
@@ -0,0 +1,163 @@
+"""CPU lifecycle tests and real base/hybrid enqueue methods with fake allocators."""
+
+import ast
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[4]
+SOURCE = ROOT / "python/sglang/srt/observability/transfer_journal.py"
+SPEC = importlib.util.spec_from_file_location("transfer_journal", SOURCE)
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+TransferJournal = MODULE.TransferJournal
+
+
+def methods(path, class_name, names, namespace):
+    tree = ast.parse((ROOT / path).read_text(encoding="utf-8"))
+    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef)
+               and n.name == class_name)
+    nodes = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name in names]
+    # Execute the actual methods without importing torch/distributed/GPU code.
+    module = ast.Module(body=[ast.ImportFrom(module="__future__", names=[
+        ast.alias(name="annotations")], level=0)] + nodes, type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module), str(path), "exec"), namespace)
+    return {name: namespace[name] for name in names}
+
+
+class FakeOperation:
+    counter = 0
+
+    def __init__(self, host, device, node, priority, **kwargs):
+        self.id = FakeOperation.counter
+        FakeOperation.counter += 1
+        self.device_indices = device
+        self.node_ids = [node]
+
+
+class Indices(list):
+    def numel(self):
+        return len(self)
+
+
+class TransferJournalTest(unittest.TestCase):
+    def test_actual_submit_and_ack_retire_only_after_tree_commit(self):
+        order = []
+        journal = TransferJournal(lambda event: order.append(event["stage"]))
+        journal.enqueue("12", 2, 64)
+        operation = SimpleNamespace(device_indices=[1, 2], node_ids=[42])
+        op_type = SimpleNamespace(merge_ops=lambda ops: operation)
+        start = methods("python/sglang/srt/managers/cache_controller.py",
+                        "HiCacheController", {"start_loading"},
+                        {"CacheOperation": op_type, "HiCacheAck": SimpleNamespace})
+        finish_event = SimpleNamespace(synchronize=lambda: order.append("sync"))
+        completion = SimpleNamespace(start_event=None, finish_event=finish_event,
+                                     timing_enabled=False)
+        controller = SimpleNamespace(
+            load_queue=[SimpleNamespace(id=12)], ack_load_queue=[],
+            reload_trace=None, transfer_journal=journal, load_fence_stream=None,
+            layer_done_counter=SimpleNamespace(update_producer=lambda: 0, events=[
+                SimpleNamespace(start_event=SimpleNamespace(record=lambda: None),
+                                complete=lambda layer: None)]),
+            _move_op_indices=lambda op: ([], [], []),
+            _l2_load_transfers=lambda *args: [], transfer_layer_id_max=1,
+            l2_transfer_engine=SimpleNamespace(submit_host_to_device=lambda *a, **k: completion),
+            _num_tokens_by_pool=lambda op: {"kv": 2},
+            _transfer_num_bytes=lambda op: 64)
+        self.assertEqual(start["start_loading"](controller), 0)
+        self.assertEqual(journal.active["12"][0], "submitted")
+        self.assertEqual(controller.load_queue, [])
+        cache = SimpleNamespace(
+            cache_controller=controller, buffer_pipeline=None,
+            ongoing_load_back={42: (42, None, None)}, metrics_collector=None,
+            dec_lock_ref=lambda *args: order.append("unlock"),
+            dec_host_lock_ref=lambda *args: None,
+            tree_core=SimpleNamespace(finish_load_back=lambda node: order.append("tree_commit")))
+        check = methods("python/sglang/srt/mem_cache/unified_radix_cache.py",
+                        "UnifiedRadixCache", {"loading_check"}, {})
+        check["loading_check"](cache, finish_count=1)
+        self.assertEqual(order, ["queued", "submitted", "sync", "unlock",
+                                 "tree_commit", "acknowledged"])
+        self.assertEqual(journal.active, {})
+
+    def test_merged_submission_conserves_bytes_and_retires_entries(self):
+        events = []
+        journal = TransferJournal(events.append, clock=lambda: 7)
+        journal.enqueue("a", 2, 100)
+        journal.enqueue("b", 3, 200)
+        journal.submit(["a", "b"])
+        self.assertEqual(events[-1]["submitted_bytes"], 300)
+        self.assertEqual(events[-1]["submitted_ops"], 2)
+        journal.complete(["a", "b"])
+        self.assertEqual(journal.active, {})
+        self.assertEqual(events[-1]["completed_bytes"], 300)
+        self.assertEqual(events[-1]["completed_tokens"], 5)
+        self.assertEqual(events[-1]["completed_ops"], 2)
+
+    def test_invalid_batch_is_atomic(self):
+        journal = TransferJournal(lambda event: None)
+        journal.enqueue("a", 0, 64)  # extra-pool-only operation is valid
+        for ids in (["a", "missing"], ["a", "a"], []):
+            with self.assertRaises(ValueError):
+                journal.submit(ids)
+            self.assertEqual(journal.active["a"][0], "queued")
+        with self.assertRaises(ValueError):
+            journal.complete(["a"])
+        with self.assertRaises(ValueError):
+            journal.enqueue("a", 0, 64)
+
+    def test_reset_reports_unresolved_without_claiming_completion(self):
+        events = []
+        journal = TransferJournal(events.append)
+        journal.enqueue("a", 2, 100)
+        journal.enqueue("b", 3, 200)
+        journal.submit(["a"])
+        journal.reset()
+        self.assertEqual(events[-1]["stage"], "reset_unresolved")
+        self.assertEqual(set(events[-1]["operation_ids"]), {"a", "b"})
+        self.assertEqual(events[-1]["submitted_bytes"], 100)
+        self.assertEqual(events[-1]["queued_bytes"], 200)
+        self.assertEqual(events[-1]["completed_ops"], 0)
+        self.assertEqual(journal.active, {})
+
+    def test_base_and_hybrid_allocation_paths_share_actual_entry(self):
+        base = methods("python/sglang/srt/managers/cache_controller.py",
+                       "HiCacheController", {"load", "_enqueue_load_operation"},
+                       {"CacheOperation": FakeOperation})
+        hybrid = methods("python/sglang/srt/mem_cache/hybrid_cache/hybrid_cache_controller.py",
+                         "HybridCacheController", {"load"},
+                         {"CacheOperation": FakeOperation})
+        for load in (base["load"], hybrid["load"]):
+            with self.subTest(load=load.__code__.co_filename):
+                events, traces, freed = [], [], []
+                allocation = SimpleNamespace(alloc=lambda n: Indices(range(n)),
+                                             free=freed.append)
+                controller = SimpleNamespace(
+                    mem_pool_device_allocator=allocation, load_queue=[],
+                    transfer_journal=TransferJournal(events.append),
+                    reload_trace=SimpleNamespace(emit=lambda *a, **k: traces.append((a, k))),
+                    _transfer_num_bytes=lambda op: len(op.device_indices) * 32,
+                    _resolve_device_transfers=lambda *a, **k: [])
+                controller._enqueue_load_operation = lambda op: base[
+                    "_enqueue_load_operation"](controller, op)
+                self.assertEqual(len(load(controller, Indices([1, 2]))), 2)
+                self.assertEqual(len(controller.load_queue), 1)
+                self.assertEqual(events[-1]["queued_bytes"], 64)
+                self.assertEqual(traces[0][1]["bytes"], 64)
+                allocation.alloc = lambda n: None
+                self.assertIsNone(load(controller, Indices([1])))
+                self.assertEqual(len(events), 1)
+                # Hybrid failure after full-pool allocation rolls back; never
+                # registers an operation for the unsuccessful extra pools.
+                if load is hybrid["load"]:
+                    allocation.alloc = lambda n: Indices(range(n))
+                    controller._resolve_device_transfers = lambda *a, **k: None
+                    self.assertIsNone(load(controller, Indices([1]), extra_pools=[1]))
+                    self.assertEqual(len(freed), 1)
+                    self.assertEqual(len(events), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
