@@ -0,0 +1,47 @@
+"""Opt-in JSONL tracing for hierarchical-cache Reload transfers.
+
+This module intentionally contains only the runtime event writer. Analysis and
+plotting belong to the external SWE experiment layer, so SGLang does not depend
+on SWE-bench in order to start.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+import time
+from pathlib import Path
+
+TIERS = ("l3_to_l2", "l2_to_hbm")
+EVENTS = ("enqueue", "start", "finish")
+
+
+class ReloadTrace:
+    """Thread-safe event writer enabled by ``SGLANG_RELOAD_TRACE_PATH``."""
+
+    def __init__(self, path: str | Path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._lock = threading.Lock()
+
+    def emit(
+        self,
+        event: str,
+        tier: str,
+        transfer_id: str,
+        *,
+        instance_id: str = "",
+        bytes: int = 0,
+    ) -> None:
+        if event not in EVENTS or tier not in TIERS:
+            raise ValueError("invalid reload event or tier")
+        row = {
+            "event": event,
+            "tier": tier,
+            "transfer_id": transfer_id,
+            "instance_id": instance_id,
+            "bytes": bytes,
+            "time_ns": time.monotonic_ns(),
+        }
+        with self._lock, self.path.open("a", encoding="utf-8") as output:
+            output.write(json.dumps(row, ensure_ascii=False) + "\n")
