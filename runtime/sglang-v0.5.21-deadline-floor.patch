+            ok = feasible(jobs, missing, check_now, self.shared, self.per_session)
+            self.phase = 'ADJUST' if ok else 'INFEASIBLE'
+            freed = 0
+            reductions = {}
+            boundary = False
+            if ok and (shortfall or (self.pressure and not self.demand_only)):
+                limit = (math.ceil(shortfall/page)*page if shortfall and self.last_decision.get('boundary') else self.quantum)
