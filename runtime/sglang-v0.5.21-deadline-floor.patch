@@ -0,0 +1,44 @@
+"""Regression test for graceful HiCache shutdown ordering."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+
+
+def test_release_host_resources_stops_storage_before_destroying_host_pool():
+    calls = []
+    cache = UnifiedRadixCache.__new__(UnifiedRadixCache)
+    cache.linker = SimpleNamespace(close=lambda: calls.append("linker.close"))
+    cache.cache_controller = SimpleNamespace(
+        detach_storage_backend=lambda: calls.append("controller.detach")
+    )
+    cache.host_pool_group = SimpleNamespace(
+        destroy=lambda: calls.append("host_pool.destroy")
+    )
+
+    cache.release_host_resources()
+
+    assert calls == [
+        "linker.close",
+        "controller.detach",
+        "host_pool.destroy",
+    ]
+
+
+def test_release_host_resources_does_not_destroy_pool_if_threads_fail_to_stop():
+    cache = UnifiedRadixCache.__new__(UnifiedRadixCache)
+    cache.linker = None
+    cache.cache_controller = SimpleNamespace(
+        detach_storage_backend=Mock(side_effect=RuntimeError("thread still alive"))
+    )
+    cache.host_pool_group = SimpleNamespace(destroy=Mock())
+
+    try:
+        cache.release_host_resources()
+    except RuntimeError as exc:
+        assert "thread still alive" in str(exc)
+    else:
+        raise AssertionError("shutdown must fail closed when a storage thread is alive")
+
+    cache.host_pool_group.destroy.assert_not_called()
