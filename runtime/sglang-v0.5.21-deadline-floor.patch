@@ -0,0 +1,75 @@
+"""Exercise the real method without importing the GPU runtime."""
+import ast
+import importlib.util
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+from typing import Optional
+from unittest.mock import Mock
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[4] / 'python/sglang/srt/mem_cache'
+spec = importlib.util.spec_from_file_location(
+    'noop_probability', ROOT / 'joint_policy/probability_residency.py')
+model = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = model
+spec.loader.exec_module(model)
+tree = ast.parse((ROOT / 'unified_radix_cache.py').read_text(encoding='utf-8'))
+cls = next(n for n in tree.body if isinstance(n, ast.ClassDef)
+           and n.name == 'UnifiedRadixCache')
+method = next(n for n in cls.body if isinstance(n, ast.FunctionDef)
+              and n.name == 'set_tool_return_probability')
+method.decorator_list = []
+space = dict(Optional=Optional, BASE_COMPONENT_TYPE=0,
+             decide_probability_residency=model.decide_probability_residency)
+exec(compile(ast.Module(body=[method], type_ignores=[]), '<real-method>', 'exec'), space)
+
+
+def cache(resident=16, pressure=2.0, usage=.9):
+    nodes = [SimpleNamespace(key=range(resident),
+                             component_data=[SimpleNamespace(value=object())])]
+    if resident < 16:
+        nodes.append(SimpleNamespace(key=range(16-resident),
+                                     component_data=[SimpleNamespace(value=None)]))
+    return SimpleNamespace(
+        enable_session_radix_cache=True, cache_controller=object(), page_size=1,
+        probability_residency_check=True, probability_evict_pressure=pressure,
+        probability_reload_foreground_first=False, probability_foreground_pending=False,
+        _session_full_path=lambda _: nodes, _device_token_usage=lambda: usage,
+        check_probability_residency_contiguity=Mock(return_value=[]),
+        _split_full_path_at=Mock(side_effect=RuntimeError('mutation reached')))
+
+
+@pytest.mark.parametrize('resident,target', [(16, .5), (16, 1), (8, .5)])
+def test_blocked_or_already_satisfied_target_never_splits(resident, target):
+    c = cache(resident)
+    result = space['set_tool_return_probability'](c, 'sid', target)
+    assert result['evicted_tokens'] == 0
+    c._split_full_path_at.assert_not_called()
+    c.check_probability_residency_contiguity.assert_called_once()
+    if resident == 16 and target == .5:
+        assert result['evict_stop_reason'] == 'below_pressure'
+        assert result['planned_evict_tokens'] == 8
+
+
+@pytest.mark.parametrize('resident,target,pressure', [(16, .5, .8), (8, 1, 2)])
+def test_real_eviction_and_reload_still_reach_mutation(resident, target, pressure):
+    c = cache(resident, pressure)
+    with pytest.raises(RuntimeError, match='mutation reached'):
+        space['set_tool_return_probability'](c, 'sid', target)
+    c._split_full_path_at.assert_called_once()
+
+
+def test_foreground_queue_defers_speculation_without_splitting():
+    c = cache(resident=8)
+    c.probability_reload_foreground_first = True
+    c.probability_foreground_pending = True
+    result = space['set_tool_return_probability'](c, 'sid', 1)
+    assert result['action'] == 'reload_deferred'
+    assert result['reload_defer_reason'] == 'foreground_queue'
+    assert result['planned_reload_tokens'] == 8
+    c._split_full_path_at.assert_not_called()
+    c.probability_foreground_pending = False
+    with pytest.raises(RuntimeError, match='mutation reached'):
+        space['set_tool_return_probability'](c, 'sid', 1)
diff --git a/test/registered/unit/mem_cache/test_transfer_journal.py b/test/registered/unit/mem_cache/test_transfer_journal.py
