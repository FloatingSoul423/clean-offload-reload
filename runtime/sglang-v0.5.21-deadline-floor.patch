+def plan_evict(jobs, now, shared_rate, session_rate, limit, page):
+    """Far deadline first; binary search each page-aligned safe increment.
+
+    Returns actual target reductions, boundary flag, and initial feasibility.
+    The constraints form a flow polymatroid; greedy computes a maximum total
+    extension. An operational limit truncates that extension to one quantum.
+    """
+    if page <= 0 or limit < 0:
+        raise ValueError("invalid page or limit")
+    missing = {j.sid: j.total-j.resident for j in jobs}
+    if not feasible(jobs, missing, now, shared_rate, session_rate):
+        return {}, False, False
+    reductions = {}
+    remaining = int(limit) // page
+    for j in sorted(jobs, key=lambda x: (x.deadline, x.sid), reverse=True):
+        lo, hi = 0, min(j.reclaimable // page, remaining)
+        original = missing[j.sid]
+        while lo < hi:
+            mid = (lo+hi+1)//2
+            missing[j.sid] = original + mid*page
+            if feasible(jobs, missing, now, shared_rate, session_rate):
+                lo = mid
+            else:
+                hi = mid-1
+        missing[j.sid] = original + lo*page
+        if lo:
+            reductions[j.sid] = lo*page
+            remaining -= lo
+    # Check whether even one more page can be reclaimed safely.
+    boundary = True
+    for j in jobs:
+        if j.reclaimable - reductions.get(j.sid, 0) >= page:
+            missing[j.sid] += page
+            possible = feasible(jobs, missing, now, shared_rate, session_rate)
+            missing[j.sid] -= page
+            if possible:
+                boundary = False
+                break
+    return reductions, boundary, True
+
+
+def reload_targets(jobs, now, shared_rate, session_rate, horizon, page):
+    """Minimum EDF repairs to remain feasible at the next control tick.
+
+    Returned amounts are targets to submit, NOT completed transfers.
+    """
+    missing = {j.sid: j.total-j.resident for j in jobs}
+    targets = {}
+    for j in sorted(jobs, key=lambda x: (x.deadline, x.sid)):
+        if feasible(jobs, missing, now+horizon, shared_rate, session_rate):
+            break
+        old = missing[j.sid]
+        if not old:
+            continue
+        missing[j.sid] = 0
+        if feasible(jobs, missing, now+horizon, shared_rate, session_rate):
+            lo, hi = 0, math.ceil(old/page)
+            while lo < hi:
+                mid = (lo+hi)//2
+                missing[j.sid] = max(0, old-mid*page)
+                if feasible(jobs, missing, now+horizon, shared_rate, session_rate):
+                    hi = mid
+                else:
+                    lo = mid+1
+            missing[j.sid] = max(0, old-lo*page)
+        targets[j.sid] = j.total-missing[j.sid]
+    return targets
