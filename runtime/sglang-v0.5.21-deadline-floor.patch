@@ -0,0 +1,52 @@
+import importlib.util
+import json
+import threading
+from pathlib import Path
+
+import pytest
+
+_MODULE_PATH = (
+    Path(__file__).resolve().parents[4]
+    / "python"
+    / "sglang"
+    / "srt"
+    / "observability"
+    / "reload_trace.py"
+)
+_SPEC = importlib.util.spec_from_file_location("reload_trace_under_test", _MODULE_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+_MODULE = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(_MODULE)
+ReloadTrace = _MODULE.ReloadTrace
+
+
+def test_reload_trace_writes_complete_json_lines(tmp_path):
+    path = tmp_path / "reload.jsonl"
+    trace = ReloadTrace(path)
+
+    threads = [
+        threading.Thread(
+            target=trace.emit,
+            args=("enqueue", "l2_to_hbm", str(index)),
+            kwargs={"bytes": index},
+        )
+        for index in range(8)
+    ]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+
+    rows = [json.loads(line) for line in path.read_text().splitlines()]
+    assert len(rows) == 8
+    assert {row["transfer_id"] for row in rows} == {str(i) for i in range(8)}
+
+
+@pytest.mark.parametrize(
+    ("event", "tier"),
+    [("bad", "l2_to_hbm"), ("enqueue", "bad")],
+)
+def test_reload_trace_rejects_invalid_values(tmp_path, event, tier):
+    trace = ReloadTrace(tmp_path / "reload.jsonl")
+    with pytest.raises(ValueError):
+        trace.emit(event, tier, "1")
