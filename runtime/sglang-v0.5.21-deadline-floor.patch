+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+_MODULE_PATH = (
+    Path(__file__).resolve().parents[4]
+    / "python"
+    / "sglang"
+    / "srt"
+    / "mem_cache"
+    / "joint_policy"
+    / "probability_residency.py"
+)
+_SPEC = importlib.util.spec_from_file_location("probability_residency", _MODULE_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+_MODULE = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = _MODULE
+_SPEC.loader.exec_module(_MODULE)
+decide = _MODULE.decide_probability_residency
+ReloadMicrobatchState = _MODULE.ReloadMicrobatchState
+
+
+def test_probability_controls_page_aligned_target():
+    decision = decide(
+        total_tokens=100, resident_tokens=100, return_probability=0.33, page_size=16
+    )
+    assert decision.target_tokens == 48
+    assert decision.evict_tokens == 52
+    assert decision.reload_tokens == 0
+
+
+def test_probability_growth_proactively_requests_reload_before_return():
+    decision = decide(
+        total_tokens=128, resident_tokens=32, return_probability=0.75, page_size=16
+    )
+    assert decision.target_tokens == 96
+    assert decision.reload_tokens == 64
+
+
+@pytest.mark.parametrize("probability,target", [(0.0, 0), (1.0, 127)])
+def test_probability_endpoints(probability, target):
+    decision = decide(
+        total_tokens=127,
+        resident_tokens=0,
+        return_probability=probability,
+        page_size=16,
+    )
+    assert decision.target_tokens == target
+
+
+def test_rejects_invalid_probability():
+    with pytest.raises(ValueError, match="return_probability"):
+        decide(
+            total_tokens=128,
+            resident_tokens=64,
+            return_probability=1.1,
+            page_size=16,
+        )
+
+
+def test_reload_microbatch_waits_then_merges_operations():
+    batch = ReloadMicrobatchState(window_s=0.1)
+    batch.enqueue(100, now=10.0)
+    batch.enqueue(200, now=10.04)
+    assert not batch.should_flush(now=10.099)
+    assert batch.should_flush(now=10.1)
+    assert batch.drain(now=10.1) == {
+        "operations": 2,
+        "planned_tokens": 300,
+        "urgent": False,
+        "aggregation_wait_ms": 100.0,
+    }
+    assert not batch.should_flush(now=11.0)
+
+
+def test_reload_microbatch_urgent_flushes_without_waiting():
+    batch = ReloadMicrobatchState(window_s=0.1)
+    batch.enqueue(128, urgent=True, now=20.0)
+    assert batch.should_flush(now=20.001)
