+
+def test_allocator_shortfall_uses_floor_then_native_remainder():
+    source = ROOT / "python/sglang/srt/mem_cache/unified_radix_cache.py"
+    tree = ast.parse(source.read_text(encoding="utf-8"))
+    cls = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "UnifiedRadixCache"
+    )
+    method = next(
+        node
+        for node in cls.body
+        if isinstance(node, ast.FunctionDef) and node.name == "evict_for_alloc"
+    )
+    method.decorator_list = []
+
+    @dataclass
+    class Params:
+        num_tokens: int = 0
+
+    @dataclass
+    class Result:
+        num_tokens_evicted: int = 0
+
+    namespace = {
+        "ComponentType": SimpleNamespace(FULL=0),
+        "EvictParams": Params,
+        "EvictResult": Result,
+        "logger": SimpleNamespace(warning=lambda *args: None),
+        "replace": replace,
+    }
+    exec(  # noqa: S102 - execute the extracted shipped method in a stub namespace
+        compile(ast.Module(body=[method], type_ignores=[]), str(source), "exec"),
+        namespace,
+    )
+
+    state = {"free": 0, "safe": 3, "native": []}
+
+    def floor_tick(shortfall):
+        freed = min(state["safe"], shortfall)
+        state["free"] += freed
+        state["safe"] -= freed
+        return freed
+
+    def native(params):
+        state["native"].append(params.num_tokens)
+        return Result(params.num_tokens)
+
+    cache = SimpleNamespace(
+        disable=False,
+        two_phase_enabled=False,
+        deadline_floor_enabled=True,
+        _get_deadline_floor_controller=lambda: SimpleNamespace(
+            tick=floor_tick, last_decision={}
+        ),
+        _component_available_size=lambda _: state["free"],
+        _evict_for_alloc_native=native,
+    )
+    result = namespace["evict_for_alloc"](cache, Params(5))
+    assert result.num_tokens_evicted == 5
+    assert state["native"] == [2]
