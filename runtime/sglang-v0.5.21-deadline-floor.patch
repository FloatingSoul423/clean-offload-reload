new file mode 100644
index 0000000000000000000000000000000000000000..1b794d3acf26720833e434ff07f3d1103c6dd404
--- /dev/null
+++ b/python/sglang/srt/mem_cache/joint_policy/deadline_floor.py
@@ -0,0 +1,352 @@
+"""Deadline residency floors with an idle-only global reserve watermark.
+
+The controller never demotes cache merely because time or utilization crossed a
+threshold.  It uses the v6 fluid-link feasibility model for two operations:
+
+* without an allocator shortfall, reload only the minimum EDF repair needed to
+  keep all registered sessions feasible at the next control horizon;
+* while the scheduler and cache-transfer pipeline are fully idle, reclaim a
+  bounded far-deadline suffix to restore allocator headroom;
+* with a real allocator shortfall, reclaim far-deadline suffixes immediately
+  without making the registered deadline set infeasible.
+
+Rates are configured as sustainable token rates and multiplied by an explicit
+safety factor (0.9 by default).  Units are allocator tokens and monotonic time.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+import time
+
+from sglang.srt.mem_cache.joint_policy.two_phase import (
+    Job,
+    feasible,
+    plan_evict,
+    reload_targets,
+)
+
+logger = logging.getLogger(__name__)
+
+
+class DeadlineFloorController:
+    """Maintain EDF floors plus a hysteretic, idle-only allocator reserve."""
+
+    def __init__(self, cache):
+        import torch
+
+        if (
+            torch.distributed.is_initialized()
+            and torch.distributed.get_world_size() > 1
+        ):
+            raise ValueError("deadline-floor currently supports one GPU/rank only")
+        from sglang.srt.mem_cache.unified_cache.components import ComponentType
+
+        if list(cache.tree_components) != [ComponentType.FULL]:
+            raise ValueError("deadline-floor supports Full KV only")
+        if not cache.enable_session_radix_cache or cache.cache_controller is None:
+            raise ValueError("deadline-floor requires session radix cache and HiCache")
+
+        self.cache = cache
+        self.deadlines: dict[str, float] = {}
+        self.last_tick = 0.0
+        self.interval = float(os.getenv("SGLANG_DEADLINE_FLOOR_INTERVAL", "0.05"))
+        self.shared = float(os.getenv("SGLANG_DEADLINE_FLOOR_SHARED_TOKENS_S", "80000"))
+        self.per_session = float(
+            os.getenv("SGLANG_DEADLINE_FLOOR_SESSION_TOKENS_S", "10000")
+        )
+        self.safety = float(os.getenv("SGLANG_DEADLINE_FLOOR_SAFETY", "0.9"))
+        self.reserve_low = float(
+            os.getenv("SGLANG_DEADLINE_FLOOR_RESERVE_LOW", "0.10")
+        )
+        self.reserve_high = float(
+            os.getenv("SGLANG_DEADLINE_FLOOR_RESERVE_HIGH", "0.15")
+        )
+        self.reserve_step = float(
+            os.getenv("SGLANG_DEADLINE_FLOOR_RESERVE_STEP", "0.02")
+        )
+        self.reserve_cooldown = float(
+            os.getenv("SGLANG_DEADLINE_FLOOR_RESERVE_COOLDOWN", "0.5")
+        )
+        self.idle_grace = float(
+            os.getenv("SGLANG_DEADLINE_FLOOR_IDLE_GRACE", "0.1")
+        )
+        self.reserve_active = False
+        self.idle_since: float | None = None
+        self.last_reserve = float("-inf")
+        self.busy = False
+        self.last_decision: dict[str, object] = {}
+        if (
+            not all(
+                math.isfinite(v) and v > 0
+                for v in (self.shared, self.per_session, self.interval)
+            )
+            or not math.isfinite(self.safety)
+            or not 0 < self.safety <= 1
+            or not all(
+                math.isfinite(v)
+                for v in (
+                    self.reserve_low,
+                    self.reserve_high,
+                    self.reserve_step,
+                    self.reserve_cooldown,
+                    self.idle_grace,
+                )
+            )
+            or not 0 <= self.reserve_low < self.reserve_high < 1
+            or not 0 < self.reserve_step <= self.reserve_high
+            or self.reserve_cooldown < 0
+            or self.idle_grace < 0
+        ):
+            raise ValueError("invalid deadline-floor configuration")
+
+    @property
+    def budget_shared(self) -> float:
+        return self.shared * self.safety
+
+    @property
+    def budget_per_session(self) -> float:
+        return self.per_session * self.safety
+
+    def update(self, sid, action, seconds):
+        if action == "begin":
+            if seconds is None or not math.isfinite(seconds) or not 0 < seconds <= 3600:
+                raise ValueError("deadline_seconds must be within (0, 3600]")
+            if sid not in self.deadlines:
+                self.deadlines[sid] = time.monotonic() + seconds
+            # A floor is a lower bound, never a command to demote on entry.
+            # The scheduler already ticks this controller every loop.  Keep the
+            # control-plane request O(1): synchronously snapshotting every
+            # registered radix path here stalls foreground scheduling even when
+            # the cache is fully resident and no floor repair is necessary.
+            return {"applied": True, "action": "none", "registered": True}
+        elif action == "end":
+            self.deadlines.pop(sid, None)
+            return self.cache.set_tool_return_probability(sid, 1.0)
+        elif action != "poll":
+            raise ValueError("invalid deadline-floor action")
+        self.tick()
+        return {"applied": True, "action": "deadline_floor", **self.last_decision}
+
+    def snapshot(self):
+        cache = self.cache
+        from sglang.srt.mem_cache.unified_cache.components import ComponentType
+
+        full = ComponentType.FULL
+        paths = {sid: cache._session_full_path(sid) for sid in self.deadlines}
+        counts: dict[int, int] = {}
+        for path in paths.values():
+            for node in path:
+                counts[node.id] = counts.get(node.id, 0) + 1
+
+        jobs = []
+        for sid, path in paths.items():
+            if not path:
+                continue
+            total = sum(len(node.key) for node in path)
+            resident = sum(
+                len(node.key)
+                for node in path
+                if node.component_data[full].value is not None
+            )
+            reclaimable = 0
+            for node in reversed(path):
+                component = node.component_data[full]
+                if component.value is None:
+                    continue
+                if (
+                    counts[node.id] > 1
+                    or component.host_value is None
+                    or node.write_through_pending_id is not None
+                    or any(data.lock_ref > 0 for data in node.component_data)
+                ):
+                    break
+                if any(child not in path for child in node.children.values()):
+                    break
+                reclaimable += len(node.key)
+            host_ready = all(
+                node.component_data[full].host_value is not None
+                and node.write_through_pending_id is None
+                for node in path
+                if node.component_data[full].value is None
+            )
+            jobs.append(
+                Job(
+                    sid,
+                    self.deadlines[sid],
+                    total,
+                    resident,
+                    reclaimable,
+                    host_ready,
+                )
+            )
+        return jobs
+
+    def tick(self, shortfall=0):
+        """Apply one floor repair, idle reserve step, or demand reclaim."""
+        if shortfall < 0:
+            raise ValueError("shortfall must be non-negative")
+        if self.busy:
+            return 0
+        now = time.monotonic()
+        scheduler_idle = bool(
+            getattr(self.cache, "deadline_floor_scheduler_idle", False)
+        )
+        if not shortfall:
+            if scheduler_idle:
+                if self.idle_since is None:
+                    self.idle_since = now
+            else:
+                self.idle_since = None
+        if not shortfall and now - self.last_tick < self.interval:
+            return 0
+
+        self.busy = True
+        try:
+            self.last_tick = now
+            cache = self.cache
+            if cache.ongoing_load_back:
+                self.last_decision = {
+                    "mode": "DEMAND" if shortfall else "FLOOR",
+                    "deferred": "h2d_inflight",
+                    "shortfall_tokens": shortfall,
+                }
+                return 0
+
+            jobs = self.snapshot()
+            page = cache.page_size
+            allocator = cache.token_to_kv_pool_allocator
+            capacity = allocator.size_full
+            available = cache._component_available_size(cache.tree_components[0])
+            if not 0 < capacity or not 0 <= available <= capacity:
+                raise ValueError("invalid deadline-floor allocator accounting")
+            horizon_now = now + self.interval * 2
+            missing = {job.sid: job.total - job.resident for job in jobs}
+            model_feasible = feasible(
+                jobs,
+                missing,
+                horizon_now,
+                self.budget_shared,
+                self.budget_per_session,
+            )
+            freed = 0
+            reductions: dict[str, int] = {}
+            targets: dict[str, int] = {}
+            reserve_requested = 0
+            reserve_deferred = None
+
+            low_tokens = math.ceil(self.reserve_low * capacity / page) * page
+            high_tokens = math.ceil(self.reserve_high * capacity / page) * page
+            if available >= high_tokens:
+                self.reserve_active = False
+            elif available < low_tokens:
+                self.reserve_active = True
+
+            if not shortfall and self.reserve_active:
+                if not scheduler_idle:
+                    reserve_deferred = "scheduler_busy"
+                elif self.idle_since is None or now - self.idle_since < self.idle_grace:
+                    reserve_deferred = "idle_grace"
+                elif now - self.last_reserve < self.reserve_cooldown:
+                    reserve_deferred = "cooldown"
+                elif available < high_tokens:
+                    step_tokens = max(
+                        page,
+                        math.ceil(self.reserve_step * capacity / page) * page,
+                    )
+                    reserve_requested = min(high_tokens - available, step_tokens)
+
+            if shortfall and model_feasible:
+                limit = math.ceil(shortfall / page) * page
+                reductions, _, model_feasible = plan_evict(
+                    jobs,
+                    horizon_now,
+                    self.budget_shared,
+                    self.budget_per_session,
+                    limit,
+                    page,
+                )
+                before = cache._component_available_size(cache.tree_components[0])
+                for job in sorted(jobs, key=lambda item: item.deadline, reverse=True):
+                    amount = reductions.get(job.sid, 0)
+                    if amount:
+                        cache.set_tool_return_probability(
+                            job.sid, (job.resident - amount) / job.total
+                        )
+                after = cache._component_available_size(cache.tree_components[0])
+                freed = max(0, after - before)
+            elif reserve_requested and model_feasible:
+                limit = math.ceil(reserve_requested / page) * page
+                reductions, _, model_feasible = plan_evict(
+                    jobs,
+                    horizon_now,
+                    self.budget_shared,
+                    self.budget_per_session,
+                    limit,
+                    page,
+                )
+                before = available
+                for job in sorted(jobs, key=lambda item: item.deadline, reverse=True):
+                    amount = reductions.get(job.sid, 0)
+                    if amount:
+                        cache.set_tool_return_probability(
+                            job.sid, (job.resident - amount) / job.total
+                        )
+                after = cache._component_available_size(cache.tree_components[0])
+                freed = max(0, after - before)
+                if freed:
+                    self.last_reserve = now
+                if after >= high_tokens:
+                    self.reserve_active = False
+            elif not shortfall:
+                targets = reload_targets(
+                    jobs,
+                    now,
+                    self.budget_shared,
+                    self.budget_per_session,
+                    self.interval * 2,
+                    page,
+                )
+                for job in sorted(jobs, key=lambda item: item.deadline):
+                    target = targets.get(job.sid)
+                    if target is not None and target > job.resident:
+                        cache.set_tool_return_probability(job.sid, target / job.total)
+
+            self.last_decision = {
+                "version": "8.1-idle-reserve",
+                "mode": (
+                    "DEMAND"
+                    if shortfall
+                    else "IDLE_RESERVE"
+                    if reserve_requested
+                    else "FLOOR"
+                ),
+                "shortfall_tokens": shortfall,
+                "capacity_tokens": capacity,
+                "available_tokens_before": available,
+                "reserve_low_tokens": low_tokens,
+                "reserve_high_tokens": high_tokens,
+                "reserve_active": self.reserve_active,
+                "reserve_requested_tokens": reserve_requested,
+                "reserve_deferred": reserve_deferred,
+                "planned_evict_tokens": sum(reductions.values()),
+                "planned_reload_tokens": sum(
+                    max(0, targets.get(job.sid, job.resident) - job.resident)
+                    for job in jobs
+                ),
+                "freed_tokens": freed,
+                "model_feasible": model_feasible,
+                "safety": self.safety,
+            }
+            if (
+                shortfall
+                or reductions
+                or targets
+                or not model_feasible
+            ):
+                logger.info("deadline-floor decision: %s", self.last_decision)
+            return freed
+        finally:
+            self.busy = False
diff --git a/python/sglang/srt/mem_cache/joint_policy/pressure_telemetry.py b/python/sglang/srt/mem_cache/joint_policy/pressure_telemetry.py
