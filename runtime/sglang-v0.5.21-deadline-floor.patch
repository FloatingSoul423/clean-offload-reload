+++ b/python/sglang/srt/mem_cache/joint_policy/probability_residency.py
@@ -0,0 +1,119 @@
+"""Minimal probability-controlled HBM residency model.
+
+The model deliberately has one policy signal: the current cumulative
+probability that a waiting tool call has returned.  A session keeps the same
+fraction of its reusable KV on the device.  Increasing probability therefore
+produces a proactive Reload decision even before the next request arrives.
+"""
+
+from __future__ import annotations
+
+import math
+import time
+from dataclasses import dataclass
+from typing import Optional
+
+
+@dataclass(frozen=True)
+class ProbabilityResidencyDecision:
+    total_tokens: int
+    resident_tokens: int
+    target_tokens: int
+    evict_tokens: int
+    reload_tokens: int
+
+
+@dataclass
+class ReloadMicrobatchState:
+    """Collect independent session Reload decisions for one short window."""
+
+    window_s: float
+    first_enqueue_time: Optional[float] = None
+    operations: int = 0
+    planned_tokens: int = 0
+    urgent_requested: bool = False
+
+    def enqueue(
+        self,
+        planned_tokens: int,
+        *,
+        urgent: bool = False,
+        now: Optional[float] = None,
+    ) -> None:
+        if planned_tokens <= 0:
+            raise ValueError("planned_tokens must be positive")
+        if self.window_s < 0:
+            raise ValueError("window_s must be non-negative")
+        now = time.monotonic() if now is None else now
+        if self.first_enqueue_time is None:
+            self.first_enqueue_time = now
+        self.operations += 1
+        self.planned_tokens += planned_tokens
+        self.urgent_requested = self.urgent_requested or urgent
+
+    def should_flush(self, *, urgent: bool = False, now: Optional[float] = None) -> bool:
+        if self.operations == 0:
+            return False
+        if urgent or self.urgent_requested or self.window_s == 0:
+            return True
+        now = time.monotonic() if now is None else now
+        return now - self.first_enqueue_time >= self.window_s - 1e-9
+
+    def drain(self, now: Optional[float] = None) -> dict:
+        if self.operations == 0:
+            return {}
+        now = time.monotonic() if now is None else now
+        result = {
+            "operations": self.operations,
+            "planned_tokens": self.planned_tokens,
+            "urgent": self.urgent_requested,
+            "aggregation_wait_ms": round(
+                1000 * (now - self.first_enqueue_time), 3
+            ),
+        }
+        self.first_enqueue_time = None
+        self.operations = 0
+        self.planned_tokens = 0
+        self.urgent_requested = False
+        return result
+
+
+def decide_probability_residency(
+    *,
+    total_tokens: int,
+    resident_tokens: int,
+    return_probability: float,
+    page_size: int,
+) -> ProbabilityResidencyDecision:
+    """Map tool-return probability to a page-aligned HBM target.
+
+    ``target = probability * reusable KV`` is rounded up to a cache page so a
+    non-zero probability keeps at least one page and the radix structure is
+    never cut inside a page.  The returned delta has exactly one direction.
+    """
+    if total_tokens < 0 or resident_tokens < 0:
+        raise ValueError("token counts must be non-negative")
+    if resident_tokens > total_tokens:
+        raise ValueError("resident_tokens cannot exceed total_tokens")
+    if page_size <= 0:
+        raise ValueError("page_size must be positive")
+    if not 0.0 <= return_probability <= 1.0:
+        raise ValueError("return_probability must be in [0, 1]")
+
+    if total_tokens == 0 or return_probability == 0.0:
+        target = 0
+    elif return_probability == 1.0:
+        target = total_tokens
+    else:
+        target = min(
+            total_tokens,
+            math.ceil(return_probability * total_tokens / page_size) * page_size,
+        )
+
+    return ProbabilityResidencyDecision(
+        total_tokens=total_tokens,
+        resident_tokens=resident_tokens,
+        target_tokens=target,
+        evict_tokens=max(0, resident_tokens - target),
+        reload_tokens=max(0, target - resident_tokens),
+    )
diff --git a/python/sglang/srt/mem_cache/joint_policy/residency_invariants.py b/python/sglang/srt/mem_cache/joint_policy/residency_invariants.py
