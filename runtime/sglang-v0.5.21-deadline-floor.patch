+++ b/python/sglang/srt/mem_cache/joint_policy/pressure_telemetry.py
@@ -0,0 +1,117 @@
+"""Optional, time-based KV pool observations for pressure-policy experiments."""
+
+import math
+import time
+
+
+class PressureSampler:
+    def __init__(self, interval_s, clock=time.monotonic, queue_clock=time.perf_counter):
+        if not 0 < interval_s <= 60:
+            raise ValueError("pressure sample interval must be in (0, 60] seconds")
+        self.interval_s = interval_s
+        self.clock = clock
+        self.queue_clock = queue_clock
+        self.next_due = None
+        self.last_sample = None
+        self.no_token_attempts = 0
+        self.prefetch_pending_attempts = 0
+
+    def record_prefill_defer(self, reason):
+        if reason == "no_token":
+            self.no_token_attempts += 1
+        elif reason == "prefetch_pending":
+            self.prefetch_pending_attempts += 1
+        else:
+            raise ValueError("unknown prefill defer reason")
+
+    def admitted_queue_intervals(self, entry_times):
+        """Completed waiting episodes, independent of the periodic sample gate.
+
+        Only requests removed from waiting_queue for prefill admission belong
+        here. Chunk continuations, aborts and still-waiting requests do not.
+        Both endpoints use perf_counter; never join these with monotonic_s.
+        """
+        now = self.queue_clock()
+        entries = list(entry_times)
+        valid = [entry for entry in entries
+                 if math.isfinite(entry) and 0 < entry <= now]
+        return {
+            "queue_clock_s": now,
+            "entry_times_s": valid,
+            "admitted_episodes": len(entries),
+            "invalid_entry_times": len(entries) - len(valid),
+        }
+
+    def maybe_sample(self, cache, waiting_requests, waiting_entry_times=()):
+        now = self.clock()
+        if self.last_sample is not None and now < self.last_sample:
+            raise ValueError("monotonic clock moved backward")
+        if self.next_due is not None and now < self.next_due:
+            return None
+
+        allocator = cache.token_to_kv_pool_allocator
+        capacity = allocator.size_full
+        available = cache._component_available_size(cache.tree_components[0])
+        evictable = cache.full_evictable_size()
+        if not 0 < capacity or not 0 <= available <= capacity or not 0 <= evictable <= capacity - available:
+            raise ValueError("invalid full-token pool accounting")
+        if waiting_requests < 0:
+            raise ValueError("negative waiting request count")
+        queue_now = self.queue_clock()
+        ages = [max(0.0, queue_now - entry) for entry in waiting_entry_times
+                if entry > 0]
+        ages.sort()
+        if len(ages) > waiting_requests:
+            raise ValueError("more queue ages than waiting requests")
+
+        elapsed = None if self.last_sample is None else now - self.last_sample
+        allocated = capacity - available
+        controller = cache.cache_controller
+        if controller is None:
+            queued_tokens = queued_bytes = submitted_tokens = submitted_bytes = 0
+            queued_ops = submitted_ops = 0
+        else:
+            queued = controller.load_queue
+            submitted = controller.ack_load_queue
+            queued_ops = len(queued)
+            submitted_ops = len(submitted)
+            queued_tokens = sum(len(op.device_indices) for op in queued)
+            queued_bytes = sum(controller._transfer_num_bytes(op) for op in queued)
+            submitted_tokens = sum(ack.num_tokens for ack in submitted)
+            submitted_bytes = sum(ack.num_bytes for ack in submitted)
+        sample = {
+            "monotonic_s": now,
+            "elapsed_since_sample_s": elapsed,
+            "capacity_tokens": capacity,
+            "available_tokens": available,
+            "evictable_tokens": evictable,
+            "allocated_tokens": allocated,
+            "non_evictable_tokens": allocated - evictable,
+            "allocation_usage": allocated / capacity,
+            "non_evictable_usage": (allocated - evictable) / capacity,
+            "waiting_requests": waiting_requests,
+            "waiting_age_observed_requests": len(ages),
+            "waiting_age_max_s": ages[-1] if ages else None,
+            "waiting_age_p95_s": (ages[max(0, (95 * len(ages) + 99) // 100 - 1)]
+                                  if ages else None),
+            # Attempt counts since the previous sample, not distinct requests
+            # or exact token shortfalls. A blocked request may retry many times.
+            "prefill_no_token_attempts": self.no_token_attempts,
+            "prefill_prefetch_pending_attempts": self.prefetch_pending_attempts,
+            # This is a node count, not the number of in-flight tokens.
+            "h2d_inflight_nodes": len(cache.ongoing_load_back),
+            "h2d_queued_ops": queued_ops,
+            "h2d_queued_tokens": queued_tokens,
+            "h2d_queued_bytes": queued_bytes,
+            "h2d_submitted_ops": submitted_ops,
+            "h2d_submitted_tokens": submitted_tokens,
+            "h2d_submitted_bytes": submitted_bytes,
+            # Both queue stages have allocated device indices. Their tokens
+            # are already included in allocated_tokens, not added to it.
+            "h2d_reserved_tokens": queued_tokens + submitted_tokens,
+        }
+        self.last_sample = now
+        self.next_due = now + self.interval_s
+        self.no_token_attempts = 0
+        self.prefetch_pending_attempts = 0
+        return sample
diff --git a/python/sglang/srt/mem_cache/joint_policy/probability_residency.py b/python/sglang/srt/mem_cache/joint_policy/probability_residency.py
